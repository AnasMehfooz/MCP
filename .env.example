# Copy to .env (never committed). docker compose, the app, Alembic and pytest all read it.
# Real environment variables win over this file.

# --- docker-compose.yml ---
POSTGRES_USER=store
POSTGRES_PASSWORD=store
POSTGRES_DB=store
POSTGRES_PORT=5432
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# --- app ---
# Keep in sync with the POSTGRES_* values above. This default is also built into the app.
STORE_DATABASE_URL=postgresql+psycopg://store:store@localhost:5432/store
# The store the MCP server and the REST API work on (`python -m scripts.seed` prints it).
# Empty: the only store in the database, as long as there is exactly one.
STORE_ID=
STORE_LOW_STOCK_THRESHOLD=5
# Signing secret for POST /webhooks/stripe: the whsec_... value that `stripe listen` prints.
# Empty: the webhook route rejects every request.
STRIPE_WEBHOOK_SECRET=

# --- tests ---
# pytest creates one throwaway schema per test in this database.
TEST_DATABASE_URL=postgresql+psycopg://store:store@localhost:5432/store_test
