# Copy to .env (never committed). docker compose reads it automatically; the app and pytest
# read plain environment variables, so export these in your shell.

# --- docker-compose.yml ---
POSTGRES_USER=store
POSTGRES_PASSWORD=store
POSTGRES_DB=store
POSTGRES_PORT=5432
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# --- app ---
# Unset: SQLite at STORE_DB_PATH (today's default). Set: any SQLAlchemy URL.
STORE_DATABASE_URL=postgresql+psycopg://store:store@localhost:5432/store
STORE_LOW_STOCK_THRESHOLD=5

# --- tests ---
# Unset: pytest runs on SQLite. Set: pytest runs on Postgres, one throwaway schema per test.
TEST_DATABASE_URL=postgresql+psycopg://store:store@localhost:5432/store_test
